# Ignore node_modules folder for Node.js projects
node_modules/

# Ignore build directories and compiled code
dist/
build/
out/
target/

# Ignore log files and temporary files
*.log
*.tmp
*.lock

# Ignore system-specific files
.DS_Store
Thumbs.db

# Ignore environment variable files
.env
.env.local

# Ignore IDE and editor config files
.vscode/
.idea/
*.swp
*.swo

# Ignore compiled binary files
*.exe
*.dll
*.so
*.dylib
*.o
*.a

# Ignore Python-related files
__pycache__/
*.py[cod]
*.pyo

# Ignore Java-related files
*.class
*.jar
*.war
*.ear

# Ignore Rust/Cargo-related files
target/
Cargo.lock

# Ignore Ruby and Gemfile lock files
*.gem
Gemfile.lock

# Ignore macOS Finder files
.AppleDouble
.LSOverride

# Ignore files from npm/yarn lock
package-lock.json
yarn.lock

# Ignore Python virtual environments
venv/
.venv/

# Ignore SASS cache files
.sass-cache/

# Ignore coverage files
coverage/
*.lcov

# Ignore backup files
*.bak
*.orig

# Ignore compressed files
*.zip
*.tar.gz
*.tgz
*.bz2

 